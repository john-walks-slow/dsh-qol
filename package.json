{
  "name": "dsh-qol",
  "version": "1.0.5",
  "description": "Quality-of-life tweaks for the DeepSeek Harness Web UI: Chrome-style session tab bar, edge-swipe sidebar, IME/keyboard adaptation, touch feedback, full-screen mobile settings and more — 18 features, each independently toggleable from the Settings page, with instant effect and per-browser persistence. dsh Web GUI 体验优化插件：会话 Tab Bar、侧栏滑动开合、输入法/键盘适配、触摸反馈、移动端设置页全屏重写等 18 项功能，均可在设置页独立开关，即时生效并按浏览器持久保存。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "node --check lib/index.js && node --check lib/client.js",
    "prepare": "npm run build",
    "release": "npm version patch && npm pack --pack-destination /tmp",
    "e2e:integration": "dsh-e2e run e2e/integration.mjs",
    "e2e:tabbar": "dsh-e2e run e2e/tabbar-mode.mjs",
    "e2e:mobile": "dsh-e2e run e2e/mobile.mjs",
    "e2e:settings": "dsh-e2e run e2e/test-settings-features.mjs",
    "e2e:permission": "dsh-e2e run e2e/verify-permission.mjs",
    "e2e:enter": "dsh-e2e run e2e/enter-newline.mjs",
    "e2e:jump": "dsh-e2e run e2e/jump-user-msg.mjs",
    "e2e:pin": "dsh-e2e run e2e/workspace-pin.mjs",
    "e2e:real": "dsh-e2e run e2e/verify-real.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qol",
    "mobile",
    "tab-bar",
    "sidebar",
    "ime",
    "touch",
    "web-ui",
    "体验优化",
    "移动端",
    "侧边栏",
    "标签页",
    "输入法",
    "触摸"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-walks-slow/dsh-qol.git"
  },
  "bugs": {
    "url": "https://github.com/john-walks-slow/dsh-qol/issues"
  },
  "homepage": "https://github.com/john-walks-slow/dsh-qol#readme",
  "author": "johnnren"
}
